    E = 1.234567890E+34;
    '' = 0023456789012E66
    zero = 0
    one = 1
    space = " "
    quote = "\""
    backslash = '\\'
    controls = "\u{8}\u{C}\n\r\t"
		slash = "/ & /"
    alpha = abcdefghijklmnopqrstuvwyz
    ALPHA = ABCDEFGHIJKLMNOPQRSTUVWYZ
    digit = "0123456789"
    "0123456789" = digit
		special = "`1~!@#$%^&*()_+-={':[,]}|;.</>?"
    hex = "\u{123}\u{4567}\u{89AB}\u{CDEF}\u{ABCD}\u{EF4A}"
    true = @true
	  false = @false
    null = @nil
  	array = [  ]
    object = {  }
